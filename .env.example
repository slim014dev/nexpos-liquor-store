# =============================================================================
# .env.example — copy to .env and fill in real values
# =============================================================================
# For the Vite frontend (must be prefixed VITE_ to be exposed to the browser)
# These only affect which environment / proxy URL the frontend targets.

# "sandbox" or "production"
VITE_MPESA_ENV=sandbox

# URL of the local Express proxy server (no trailing slash)
# Change to your deployed URL when hosting the proxy remotely
VITE_PROXY_BASE_URL=http://localhost:3001

# =============================================================================
# For the Express proxy server (NOT exposed to the browser)
# =============================================================================

# --- Sandbox credentials (Daraja developer portal) ---------------------------
MPESA_CONSUMER_KEY=UZB6OM0luNv9GxBS7xqo8hAqJje26M8fe8ALDzrkhGtUIOdv
MPESA_CONSUMER_SECRET=jDCdx2kBfjrKi6CWWmXSr7rqP5bBgVTaXsTRj7vp0LHo4dfQUrrirOsBGb1kcBwR
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Public URL this proxy server is reachable on (ngrok URL in development)
# Safaricom calls this URL when a payment completes.
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok.io/api/mpesa/callback

# Daraja base URL — change to https://api.safaricom.co.ke for production
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# --- Production credentials (fill before going live) -------------------------
# MPESA_CONSUMER_KEY=[PROD_CONSUMER_KEY]
# MPESA_CONSUMER_SECRET=[PROD_CONSUMER_SECRET]
# MPESA_SHORTCODE=[PROD_SHORTCODE]
# MPESA_PASSKEY=[PROD_PASSKEY]
# MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
# MPESA_BASE_URL=https://api.safaricom.co.ke

# --- Proxy server settings ---------------------------------------------------
PROXY_PORT=3001

# Optional: restrict which origins may call the proxy (comma-separated)
# Leave empty to allow all (fine for local dev)
ALLOWED_ORIGINS=http://localhost:5173
